#!/usr/bin/env bash
# A stand-in for the real solaar CLI, used by the functional tests.
#
# It records every invocation to $FAKE_SOLAAR_LOG (one argv per line) so a
# test can assert the exact commands issued and their order — the thing that
# unit tests of pure functions cannot see, and precisely where this plugin's
# worst bugs lived (writes silently dropped, writes elided as no-ops).
#
# It also emulates the two device quirks that caused those bugs:
#   - a level write only takes effect while the mode is Manual
#   - a level write whose value equals the stored one is ignored
# so a plan that ignores either leaves LIVE at the wrong value here too.
set -euo pipefail

log() { printf '%s\n' "$*" >>"$FAKE_SOLAAR_LOG"; }

state_get() { grep -E "^$1=" "$FAKE_SOLAAR_STATE" 2>/dev/null | tail -1 | cut -d= -f2; }
state_set() { printf '%s=%s\n' "$1" "$2" >>"$FAKE_SOLAAR_STATE"; }

log "$*"

case "${1:-}" in
show)
  cat "$FAKE_SOLAAR_FIXTURE"
  ;;
config)
  device="${2:-}"
  setting="${3:-}"
  value="${4:-}"

  if [[ -z $value ]]; then
    # Read
    case "$setting" in
    backlight) echo "backlight = $(state_get mode)" ;;
    backlight_level) echo "backlight_level = $(state_get live)" ;;
    esac
    exit 0
  fi

  case "$setting" in
  backlight)
    state_set mode "$value"
    # Switching mode resets the LIVE level while the saved value persists —
    # the real device behaviour that made "on" leave the keyboard dark.
    [[ $value == Manual ]] && state_set live 0
    ;;
  backlight_level)
    max="$(state_get max)"; max="${max:-7}"
    if (( value > max )); then
      echo "solaar: error: backlight_level: value '$value' out of bounds" >&2
      exit 1
    fi
    if [[ "$(state_get mode)" != "Manual" ]]; then
      # Ignored outside Manual mode, exactly like the real thing.
      exit 0
    fi
    if [[ "$(state_get saved)" == "$value" ]]; then
      # solaar elides a write equal to the saved value: saved stays, LIVE
      # is NOT updated. This is the elision that left the light off.
      exit 0
    fi
    state_set saved "$value"
    state_set live "$value"
    ;;
  esac
  ;;
esac
exit 0
