#!/usr/bin/env bash
# A stand-in for the real mx-device transport, used by the functional tests.
#
# Same purpose as fake-solaar: record every invocation to $FAKE_MXD_LOG (one
# argv per line) so a test can assert *which* calls were issued and in what
# order. That is the whole claim of feature 004 — one invocation per
# user-visible action — and it is not observable from unit tests of pure
# functions.
#
# It can also emit degraded frames on demand, which the real device produces
# only intermittently and never on request. Set FAKE_MXD_DEGRADE to:
#   unreadable   a device present whose backlight could not be read
#   no-devices   the receiver is there, nothing is paired
#   no-receiver  solaar's library is not installed
#   garbage      output that is not JSON at all
# Anything else (or unset) serves $FAKE_MXD_FIXTURE.
set -euo pipefail

printf '%s\n' "$*" >>"$FAKE_MXD_LOG"

# `|| true` matters: with `set -e -o pipefail`, a grep that matches nothing
# fails the pipeline and kills the script before it can serve a fixture.
state_get() { { grep -E "^$1=" "$FAKE_MXD_STATE" 2>/dev/null || true; } | tail -1 | cut -d= -f2; }
state_set() { printf '%s=%s\n' "$1" "$2" >>"$FAKE_MXD_STATE"; }

case "${1:-}" in
state)
  case "${FAKE_MXD_DEGRADE:-}" in
  unreadable)
    cat "$(dirname "$0")/fixtures/mx-device-keyboard-unreadable.json" ;;
  no-devices)
    cat "$(dirname "$0")/fixtures/mx-device-no-devices.json" ;;
  no-receiver)
    cat "$(dirname "$0")/fixtures/mx-device-no-receiver.json" ;;
  garbage)
    printf 'Backlight Level : 3\nnot json at all\n' ;;
  *)
    # Serve the fixture, but with the level/mode this fake has been told to
    # hold, so a write followed by a read reflects the write.
    mode=$(state_get mode); level=$(state_get level)
    python3 - "$FAKE_MXD_FIXTURE" "${mode:-Manual}" "${level:-0}" <<'PY'
import json, sys
doc = json.load(open(sys.argv[1]))
for d in doc.get("devices", []):
    if d.get("backlight"):
        d["backlight"]["mode"] = sys.argv[2]
        d["backlight"]["level"] = int(sys.argv[3])
print(json.dumps(doc, separators=(",", ":")))
PY
    ;;
  esac
  ;;
set)
  # argv: set --device N (--level L | --effect E | --mode M)
  shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --device) shift 2>/dev/null || true ;;
    --level) state_set level "${2:-0}"; shift 2 ;;
    --effect) state_set effect "${2:-0}"; shift 2 ;;
    --mode) state_set mode "${2:-Manual}"; shift 2 ;;
    *) shift ;;
    esac
  done
  if [[ "${FAKE_MXD_REJECT:-}" == "1" ]]; then
    printf '{"ok":false,"error":"rejected","detail":"device rejected the write"}\n'
    exit 0
  fi
  printf '{"ok":true}\n'
  ;;
*)
  printf '{"ok":false,"error":"unreadable","detail":"unknown command"}\n'
  ;;
esac
